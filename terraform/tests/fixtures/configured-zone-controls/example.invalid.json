{
  "name": "example.invalid",
  "dns_provider": "cloudflare",
  "management": "terraform",
  "settings_preserve_existing": true,
  "settings": { "ssl": "strict" },
  "plan_profile": "pro",
  "dnssec_enabled": false,
  "waf_custom_rules_enabled": true,
  "waf_custom_ruleset": {
    "name": "synthetic-custom-firewall",
    "description": "Synthetic firewall for configuration tests",
    "rules": [
      {
        "ref": "synthetic-firewall-rule",
        "action": "block",
        "description": "Block a synthetic path",
        "enabled": true,
        "expression": "(http.request.uri.path eq \"/blocked\")"
      }
    ]
  },
  "rulesets": {
    "http_ratelimit": {
      "name": "default",
      "description": "",
      "rules": [
        {
          "ref": "synthetic-rate-limit",
          "action": "managed_challenge",
          "description": "Requests > 20 in 10 Seconds - Challenge",
          "enabled": true,
          "expression": "(http.host wildcard \"example.invalid\")",
          "ratelimit": {
            "characteristics": ["ip.src", "cf.colo.id"],
            "mitigation_timeout": 0,
            "period": 10,
            "requests_per_period": 50
          }
        }
      ]
    }
  },
  "page_rules": {
    "stats": {
      "target": "https://stats.example.invalid/*",
      "priority": 1,
      "status": "active",
      "actions": {
        "ssl": "full",
        "automatic_https_rewrites": "on"
      }
    }
  },
  "records": []
}
