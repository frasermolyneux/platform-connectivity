{
  "name": "example.invalid",
  "dns_provider": "cloudflare",
  "management": "terraform",
  "import_existing": true,
  "waf_custom_rules_enabled": false,
  "settings_preserve_existing": true,
  "dnssec_enabled": false,
  "records": [
    { "key": "alias", "type": "CNAME", "name": "www", "content": "origin.example.invalid", "import_existing": true },
    { "key": "mail", "type": "MX", "name": "@", "content": "mail.example.invalid", "priority": 0, "import_existing": true },
    { "key": "service", "type": "SRV", "name": "_sip._tcp", "data": { "priority": 10, "weight": 1, "port": 5061, "target": "sip.example.invalid" }, "import_existing": true },
    { "key": "dmarc", "type": "TXT", "name": "_dmarc", "content": "\"v=DMARC1\"", "import_existing": true }
  ]
}
