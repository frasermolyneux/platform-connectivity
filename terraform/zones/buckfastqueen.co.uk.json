{
  "name": "buckfastqueen.co.uk",
  "dns_provider": "cloudflare",
  "backup_to_azure": false,
  "management": "terraform",
  "settings_preserve_existing": true,
  "plan_profile": "free",
  "dnssec_enabled": false,
  "settings": {
    "0rtt": "off",
    "always_online": "off",
    "always_use_https": "off",
    "automatic_https_rewrites": "on",
    "brotli": "on",
    "browser_cache_ttl": 14400,
    "browser_check": "on",
    "cache_level": "aggressive",
    "challenge_ttl": 1800,
    "ciphers": [],
    "cname_flattening": "flatten_at_root",
    "development_mode": "off",
    "early_hints": "off",
    "ech": "on",
    "edge_cache_ttl": 7200,
    "email_obfuscation": "on",
    "filter_logs_to_cloudflare": "off",
    "hotlink_protection": "off",
    "http3": "on",
    "ip_geolocation": "on",
    "ipv6": "on",
    "log_to_cloudflare": "on",
    "max_upload": 100,
    "min_tls_version": "1.0",
    "minify": {
      "css": "off",
      "html": "off",
      "js": "off"
    },
    "mobile_redirect": {
      "status": "off",
      "mobile_subdomain": null,
      "strip_uri": false
    },
    "opportunistic_encryption": "on",
    "opportunistic_onion": "on",
    "orange_to_orange": "off",
    "pq_keyex": "on",
    "privacy_pass": "on",
    "pseudo_ipv4": "off",
    "replace_insecure_js": "on",
    "rocket_loader": "off",
    "security_header": {
      "strict_transport_security": {
        "enabled": false,
        "max_age": 0,
        "include_subdomains": false,
        "preload": false,
        "nosniff": false
      }
    },
    "security_level": "medium",
    "server_side_exclude": "on",
    "ssl": "flexible",
    "tls_1_2_only": "off",
    "tls_1_3": "on",
    "tls_client_auth": "off",
    "visitor_ip": "on",
    "waf": "off",
    "websockets": "on"
  },
  "records": [
    {
      "key": "apex-1",
      "type": "A",
      "name": "@",
      "ttl": 1,
      "content": "217.160.0.33",
      "proxied": true
    },
    {
      "key": "www-1",
      "type": "A",
      "name": "www",
      "ttl": 1,
      "content": "217.160.0.33",
      "proxied": true
    },
    {
      "key": "apex-1",
      "type": "AAAA",
      "name": "@",
      "ttl": 1,
      "content": "2001:8d8:100f:f000::254",
      "proxied": true
    },
    {
      "key": "www-1",
      "type": "AAAA",
      "name": "www",
      "ttl": 1,
      "content": "2001:8d8:100f:f000::254",
      "proxied": true
    },
    {
      "key": "_domainconnect-1",
      "type": "CNAME",
      "name": "_domainconnect",
      "ttl": 1,
      "content": "_domainconnect.1and1.com",
      "proxied": true
    },
    {
      "key": "autodiscover-1",
      "type": "CNAME",
      "name": "autodiscover",
      "ttl": 1,
      "content": "adsredir.ionos.info",
      "proxied": true
    },
    {
      "key": "apex-1",
      "type": "MX",
      "name": "@",
      "ttl": 1,
      "content": "mx00.ionos.co.uk",
      "priority": 10
    },
    {
      "key": "apex-2",
      "type": "MX",
      "name": "@",
      "ttl": 1,
      "content": "mx01.ionos.co.uk",
      "priority": 10
    },
    {
      "key": "apex-1",
      "type": "TXT",
      "name": "@",
      "ttl": 3600,
      "content": "v=spf1 include:_spf-eu.ionos.com ~all"
    }
  ],
  "waf_custom_rules_enabled": false,
  "page_rules": {
    "legacy-1": {
      "target": "*buckfastqueen.co.uk/*",
      "priority": 1,
      "status": "active",
      "actions": {
        "forwarding_url": {
          "url": "https://bishopsbees.co.uk/",
          "status_code": 301
        }
      }
    }
  }
}
