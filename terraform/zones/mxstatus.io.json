{
  "name": "mxstatus.io",
  "dns_provider": "cloudflare",
  "management": "terraform",
  "settings_preserve_existing": true,
  "plan_profile": "free",
  "dnssec_enabled": false,
  "settings": {
    "0rtt": "off",
    "always_online": "off",
    "always_use_https": "off",
    "automatic_https_rewrites": "on",
    "brotli": "on",
    "browser_cache_ttl": 14400,
    "browser_check": "on",
    "cache_level": "aggressive",
    "challenge_ttl": 1800,
    "ciphers": [],
    "cname_flattening": "flatten_at_root",
    "development_mode": "off",
    "early_hints": "off",
    "ech": "on",
    "edge_cache_ttl": 7200,
    "email_obfuscation": "on",
    "filter_logs_to_cloudflare": "off",
    "hotlink_protection": "off",
    "http3": "on",
    "ip_geolocation": "on",
    "ipv6": "on",
    "log_to_cloudflare": "on",
    "max_upload": 100,
    "min_tls_version": "1.0",
    "minify": {
      "css": "off",
      "html": "off",
      "js": "off"
    },
    "mobile_redirect": {
      "status": "off",
      "mobile_subdomain": null,
      "strip_uri": false
    },
    "opportunistic_encryption": "on",
    "opportunistic_onion": "on",
    "orange_to_orange": "off",
    "pq_keyex": "on",
    "privacy_pass": "on",
    "pseudo_ipv4": "off",
    "replace_insecure_js": "on",
    "rocket_loader": "off",
    "security_header": {
      "strict_transport_security": {
        "enabled": false,
        "max_age": 0,
        "include_subdomains": false,
        "preload": false,
        "nosniff": false
      }
    },
    "security_level": "medium",
    "server_side_exclude": "on",
    "ssl": "full",
    "tls_1_2_only": "off",
    "tls_1_3": "on",
    "tls_client_auth": "off",
    "visitor_ip": "on",
    "waf": "off",
    "websockets": "on"
  },
  "records": [
    {
      "key": "autodiscover-1",
      "type": "CNAME",
      "name": "autodiscover",
      "ttl": 1,
      "content": "autodiscover.outlook.com",
      "proxied": true
    },
    {
      "key": "enterpriseenrollment-1",
      "type": "CNAME",
      "name": "enterpriseenrollment",
      "ttl": 1,
      "content": "enterpriseenrollment-s.manage.microsoft.com",
      "proxied": true
    },
    {
      "key": "enterpriseregistration-1",
      "type": "CNAME",
      "name": "enterpriseregistration",
      "ttl": 1,
      "content": "enterpriseregistration.windows.net",
      "proxied": true
    },
    {
      "key": "lyncdiscover-1",
      "type": "CNAME",
      "name": "lyncdiscover",
      "ttl": 1,
      "content": "webdir.online.lync.com",
      "proxied": true
    },
    {
      "key": "sip-1",
      "type": "CNAME",
      "name": "sip",
      "ttl": 1,
      "content": "sipdir.online.lync.com",
      "proxied": true
    },
    {
      "key": "apex-1",
      "type": "MX",
      "name": "@",
      "ttl": 1,
      "content": "mxstatus-io.mail.protection.outlook.com",
      "priority": 0
    },
    {
      "key": "_sip-_tls-1",
      "type": "SRV",
      "name": "_sip._tls",
      "ttl": 1,
      "data": {
        "port": 443,
        "priority": 100,
        "target": "sipdir.online.lync.com",
        "weight": 1
      }
    },
    {
      "key": "_sipfederationtls-_tcp-1",
      "type": "SRV",
      "name": "_sipfederationtls._tcp",
      "ttl": 1,
      "data": {
        "port": 5061,
        "priority": 100,
        "target": "sipfed.online.lync.com",
        "weight": 1
      }
    },
    {
      "key": "apex-1",
      "type": "TXT",
      "name": "@",
      "ttl": 1,
      "content": "\"mscid=hNZjvdmeQWe5/9QeJW35ONLDFtpwoYdNrTiW0mAj59ie+e/WgEsTtZi90sjtsdtKtzYWBOfwfod5qrRFhPcnPA==\""
    },
    {
      "key": "apex-2",
      "type": "TXT",
      "name": "@",
      "ttl": 1,
      "content": "\"v=spf1 include:spf.protection.outlook.com -all\""
    }
  ],
  "waf_custom_rules_enabled": false
}
