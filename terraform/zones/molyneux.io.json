            "record": "enterpriseenrollment.manage.microsoft.com."
        },
        {
            "name": "selector1._domainkey",
            "record": "selector1-molyneux-io._domainkey.MolyneuxIO.r-v1.dkim.mail.microsoft."
        },
        {
            "name": "selector2._domainkey",
            "record": "selector2-molyneux-io._domainkey.MolyneuxIO.r-v1.dkim.mail.microsoft."
        }
    ],
    "mx_records": [
        {
            "name": "@",
            "records": [
                {
                    "preference": 0,
                    "exchange": "molyneux-io.mail.protection.outlook.com."
                }
            ]
        }
    ],
    "txt_records": [
        {
            "name": "_dmarc",
