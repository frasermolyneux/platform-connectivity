{
  "name": "midlr.com",
  "dns_provider": "cloudflare",
  "backup_to_azure": false,
  "management": "terraform",
  "settings_preserve_existing": true,
  "plan_profile": "free",
  "dnssec_enabled": false,
  "settings": {
    "0rtt": "off",
    "always_online": "off",
    "always_use_https": "on",
    "automatic_https_rewrites": "on",
    "brotli": "on",
    "browser_cache_ttl": 14400,
    "browser_check": "on",
    "cache_level": "aggressive",
    "challenge_ttl": 1800,
    "ciphers": [],
    "cname_flattening": "flatten_at_root",
    "development_mode": "off",
    "early_hints": "off",
    "ech": "on",
    "edge_cache_ttl": 7200,
    "email_obfuscation": "on",
    "filter_logs_to_cloudflare": "off",
    "hotlink_protection": "off",
    "http3": "on",
    "ip_geolocation": "on",
    "ipv6": "on",
    "log_to_cloudflare": "on",
    "max_upload": 100,
    "min_tls_version": "1.0",
    "minify": {
      "css": "off",
      "html": "off",
      "js": "off"
    },
    "mobile_redirect": {
      "status": "off",
      "mobile_subdomain": null,
      "strip_uri": false
    },
    "opportunistic_encryption": "on",
    "opportunistic_onion": "on",
    "orange_to_orange": "off",
    "pq_keyex": "on",
    "privacy_pass": "on",
    "pseudo_ipv4": "off",
    "replace_insecure_js": "on",
    "rocket_loader": "off",
    "security_header": {
      "strict_transport_security": {
        "enabled": false,
        "max_age": 0,
        "include_subdomains": false,
        "preload": false,
        "nosniff": false
      }
    },
    "security_level": "medium",
    "server_side_exclude": "on",
    "ssl": "full",
    "tls_1_2_only": "off",
    "tls_1_3": "on",
    "tls_client_auth": "off",
    "visitor_ip": "on",
    "waf": "off",
    "websockets": "on"
  },
  "records": [
    {
      "key": "autodiscover-1",
      "type": "CNAME",
      "name": "autodiscover",
      "ttl": 3600,
      "content": "autodiscover.outlook.com",
      "proxied": false
    },
    {
      "key": "enterpriseenrollment-1",
      "type": "CNAME",
      "name": "enterpriseenrollment",
      "ttl": 3600,
      "content": "enterpriseenrollment.manage.microsoft.com",
      "proxied": false
    },
    {
      "key": "enterpriseregistration-1",
      "type": "CNAME",
      "name": "enterpriseregistration",
      "ttl": 3600,
      "content": "enterpriseregistration.windows.net",
      "proxied": false
    },
    {
      "key": "apex-1",
      "type": "MX",
      "name": "@",
      "ttl": 3600,
      "content": "midlr-com.mail.protection.outlook.com",
      "priority": 0
    },
    {
      "key": "_sipfederationtls-_tcp-1",
      "type": "SRV",
      "name": "_sipfederationtls._tcp",
      "ttl": 3600,
      "data": {
        "port": 5061,
        "priority": 100,
        "target": "sipfed.online.lync.com",
        "weight": 1
      }
    },
    {
      "key": "asuid-www-1",
      "type": "TXT",
      "name": "asuid.www",
      "ttl": 1,
      "content": "C075B21DD93CF3A5068CCD102CAD8F897ABA519285E86A80138B26D1D56703B6"
    },
    {
      "key": "apex-1",
      "type": "TXT",
      "name": "@",
      "ttl": 3600,
      "content": "MS=ms65417230"
    },
    {
      "key": "apex-2",
      "type": "TXT",
      "name": "@",
      "ttl": 1,
      "content": "google-site-verification=CGKpKpdaZ_R49cNGOP5x4pRwv8YDfxxZAlMgio4nrHo"
    },
    {
      "key": "apex-3",
      "type": "TXT",
      "name": "@",
      "ttl": 3600,
      "content": "v=spf1 include:spf.protection.outlook.com -all"
    }
  ],
  "waf_custom_rules_enabled": false,
  "page_rules": {
    "legacy-1": {
      "target": "https://midlr.com/*",
      "priority": 1,
      "status": "active",
      "actions": {
        "forwarding_url": {
          "url": "https://www.midlr.com",
          "status_code": 301
        }
      }
    }
  }
}
