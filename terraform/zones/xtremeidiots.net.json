    "legacy-1": {
      "target": "*cdn.xtremeidiots.net/*",
      "priority": 1,
      "status": "active",
      "actions": {
        "disable_security": true,
        "browser_check": "on",
        "security_level": "essentially_off",
        "ssl": "flexible",
        "rocket_loader": "off",
        "browser_cache_ttl": 16070400,
        "cache_level": "cache_everything",
        "disable_apps": true
