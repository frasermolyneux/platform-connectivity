{
  "name": "xtremeidiots.com",
  "dns_provider": "cloudflare",
  "management": "terraform",
  "adopt_existing": true,
  "plan_profile": "pro",
  "dnssec_enabled": false,
  "preserve_settings": true,
  "settings": {
    "0rtt": "on",
    "always_online": "on",
    "always_use_https": "on",
    "automatic_https_rewrites": "off",
    "brotli": "on",
    "browser_cache_ttl": 1382400,
    "browser_check": "on",
    "cache_level": "aggressive",
    "challenge_ttl": 3600,
    "ciphers": [],
    "cname_flattening": "flatten_at_root",
    "development_mode": "off",
    "early_hints": "off",
    "ech": "off",
    "edge_cache_ttl": 7200,
    "email_obfuscation": "on",
    "filter_logs_to_cloudflare": "off",
    "hotlink_protection": "on",
    "http2": "on",
    "http3": "on",
    "ip_geolocation": "on",
    "ipv6": "on",
    "log_to_cloudflare": "on",
    "max_upload": 100,
    "min_tls_version": "1.2",
    "minify": { "css": "off", "html": "off", "js": "off" },
    "mirage": "off",
    "mobile_redirect": { "status": "off", "mobile_subdomain": null, "strip_uri": false },
    "opportunistic_encryption": "on",
    "opportunistic_onion": "on",
    "orange_to_orange": "off",
    "polish": "lossy",
    "pq_keyex": "on",
    "privacy_pass": "on",
    "pseudo_ipv4": "off",
    "replace_insecure_js": "off",
    "rocket_loader": "off",
    "security_header": {
      "strict_transport_security": {
        "enabled": false,
        "max_age": 0,
        "include_subdomains": false,
        "preload": false,
        "nosniff": false
      }
    },
    "security_level": "essentially_off",
    "server_side_exclude": "on",
    "ssl": "full",
    "tls_1_2_only": "off",
    "tls_1_3": "zrt",
    "tls_client_auth": "off",
    "visitor_ip": "on",
    "waf": "off",
    "webp": "on",
    "websockets": "on"
  },
  "waf_preserve_existing": true,
  "preserve_rulesets": true,
  "preserved_rulesets": {
    "http_request_firewall_managed": {
      "name": "default",
      "description": "",
      "rules": [
        {
          "action": "execute",
          "action_parameters": {
            "version": "latest",
            "target_name": "Cloudflare Exposed Credentials Check Ruleset"
          },
          "enabled": true,
          "expression": "true"
        },
        {
          "action": "execute",
          "action_parameters": {
            "version": "latest",
            "target_name": "Cloudflare Managed Ruleset"
          },
          "enabled": true,
          "expression": "(not http.request.uri contains \"/duc\")"
        },
        {
          "action": "execute",
          "action_parameters": {
            "version": "latest",
            "target_name": "Cloudflare OWASP Core Ruleset",
            "overrides": {
              "categories": [
                { "category": "paranoia-level-2", "enabled": false },
                { "category": "paranoia-level-3", "enabled": false },
                { "category": "paranoia-level-4", "enabled": false }
              ]
            }
          },
          "enabled": true,
          "expression": "(not http.request.uri contains \"/duc\")"
        }
      ]
    },
    "http_ratelimit": {
      "name": "default",
      "description": "",
      "rules": [
        {
          "action": "managed_challenge",
          "description": "Requests > 20 in 10 Seconds - Challenge",
          "enabled": true,
          "expression": "(http.host wildcard \"xtremeidiots.com\")",
          "ratelimit": {
            "characteristics": ["ip.src", "cf.colo.id"],
            "mitigation_timeout": 0,
            "period": 10,
            "requests_per_period": 50
          }
        },
        {
          "action": "managed_challenge",
          "description": "Duplicate of Requests > 150 in 1 Minute - Challenge",
          "enabled": true,
          "expression": "(http.host wildcard \"xtremeidiots.com\")",
          "ratelimit": {
            "characteristics": ["ip.src", "cf.colo.id"],
            "mitigation_timeout": 0,
            "period": 60,
            "requests_per_period": 150
          }
        }
      ]
    },
    "http_request_dynamic_redirect": {
      "name": "default",
      "description": "",
      "rules": [
        {
          "action": "redirect",
          "action_parameters": {
            "from_value": {
              "preserve_query_string": true,
              "status_code": 301,
              "target_url": {
                "expression": "wildcard_replace(http.request.full_uri, r\"https://xtremeidiots.com/*\", r\"https://www.xtremeidiots.com/${1}\")"
              }
            }
          },
          "description": "Redirect from Root to WWW",
          "enabled": true,
          "expression": "(http.request.full_uri wildcard r\"https://xtremeidiots.com/*\")"
        }
      ]
    }
  },
  "preserve_page_rules": true,
  "page_rules": {
    "tcadmin": {
      "target": "*tcadmin.xtremeidiots.com/*",
      "priority": 2,
      "status": "active",
      "actions": {
        "ssl": "flexible",
        "automatic_https_rewrites": "on",
        "disable_apps": true,
        "disable_performance": true
      },
      "api_actions": [
        { "id": "ssl", "value": "flexible" },
        { "id": "automatic_https_rewrites", "value": "on" },
        { "id": "disable_apps" },
        { "id": "disable_performance" }
      ]
    },
    "stats": {
      "target": "https://stats.xtremeidiots.com/*",
      "priority": 1,
      "status": "active",
      "actions": {
        "ssl": "full",
        "automatic_https_rewrites": "on"
      },
      "api_actions": [
        { "id": "ssl", "value": "full" },
        { "id": "automatic_https_rewrites", "value": "on" }
      ]
    }
  },
  "waf_custom_ruleset": {
    "name": "default",
    "description": "",
    "rules": [
      {
        "description": "Allow embedded profile photos",
        "expression": "(http.request.uri.path contains \"/profile/\")",
        "action": "skip",
        "enabled": true,
        "action_parameters": { "products": ["hot"] },
        "logging": { "enabled": true }
      },
      {
        "description": "Bypass hotlink for local host or portal",
        "expression": "(http.referer contains \"xtremeidiots.com\")",
        "action": "skip",
        "enabled": true,
        "action_parameters": { "products": ["hot"] },
        "logging": { "enabled": true }
      },
      {
        "ref": "[CF AI Audit]",
        "description": "AI Crawl Control - Block AI bots by User Agent",
        "expression": "(http.request.uri.path ne \"/robots.txt\" and ((http.user_agent contains \"Amazonbot\") or (http.user_agent contains \"Anchor Browser\") or (http.user_agent contains \"Applebot\") or (http.user_agent contains \"archive.org_bot\") or (http.user_agent contains \"Arquivo-web-crawler\") or (http.user_agent contains \"Baiduspider\") or (http.user_agent contains \"bingbot\") or (http.user_agent contains \"Bytespider\") or (http.user_agent contains \"CCBot\") or (http.user_agent contains \"ClaudeBot\") or (http.user_agent contains \"FacebookBot\") or (http.user_agent contains \"Google-CloudVertexBot\") or (http.user_agent contains \"Manus-User\") or (http.user_agent contains \"meta-externalagent\") or (http.user_agent contains \"meta-externalfetcher\") or (http.user_agent contains \"Novellum\") or (http.user_agent contains \"PerplexityBot\") or (http.user_agent contains \"PetalBot\") or (http.user_agent contains \"ProRataInc\") or (http.user_agent contains \"Terracotta\") or (http.user_agent contains \"TikTokSpider\") or (http.user_agent contains \"Timpibot\")))",
        "action": "block",
        "enabled": true,
        "action_parameters": {
          "response": {
            "content": "{\"message\":\"Please contact the site owner for access.\"}",
            "content_type": "application/json",
            "status_code": 403
          }
        }
      }
    ]
  },
