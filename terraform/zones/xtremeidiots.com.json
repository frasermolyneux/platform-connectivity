      "description": "",
      "rules": [
        {
          "ref": "2b7a4ce4b9d34fe5b47ef61c86a4f96c",
          "action": "managed_challenge",
          "description": "50 requests in 10 seconds - Challenge",
          "enabled": true,
          "expression": "(http.host eq \"www.xtremeidiots.com\")",
          "ratelimit": {
            "characteristics": [
              "ip.src",
