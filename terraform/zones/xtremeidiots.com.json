  "waf_custom_ruleset": {
    "name": "default",
    "description": "",
    "rules": [
      {
        "ref": "d946a838fcee47eeac7a579189988ccf",
        "action": "skip",
        "action_parameters": {
          "products": [
            "hot"
          ]
        },
        "description": "Allow embedded profile photos",
        "enabled": true,
        "expression": "(http.request.uri.path contains \"/profile/\")",
        "logging": {
          "enabled": true
        }
      },
      {
        "ref": "85947f3526764c4c9aed25ea7e5b6f9a",
        "action": "skip",
        "action_parameters": {
          "products": [
            "hot"
          ]
        },
        "description": "Bypass hotlink for local host or portal",
        "enabled": true,
        "expression": "(http.referer contains \"xtremeidiots.com\")",
        "logging": {
          "enabled": true
        }
      },
      {
        "action": "block",
        "action_parameters": {
          "response": {
            "content": "{\"message\":\"Please contact the site owner for access.\"}",
            "content_type": "application/json",
            "status_code": 403
          }
        },
        "description": "AI Crawl Control - Block AI bots by User Agent",
        "enabled": true,
        "expression": "(http.request.uri.path ne \"/robots.txt\" and ((http.user_agent contains \"Amazonbot\") or (http.user_agent contains \"Anchor Browser\") or (http.user_agent contains \"Applebot\") or (http.user_agent contains \"archive.org_bot\") or (http.user_agent contains \"Arquivo-web-crawler\") or (http.user_agent contains \"Baiduspider\") or (http.user_agent contains \"bingbot\") or (http.user_agent contains \"Bytespider\") or (http.user_agent contains \"CCBot\") or (http.user_agent contains \"ClaudeBot\") or (http.user_agent contains \"FacebookBot\") or (http.user_agent contains \"Google-CloudVertexBot\") or (http.user_agent contains \"Manus-User\") or (http.user_agent contains \"meta-externalagent\") or (http.user_agent contains \"meta-externalfetcher\") or (http.user_agent contains \"Novellum\") or (http.user_agent contains \"PerplexityBot\") or (http.user_agent contains \"PetalBot\") or (http.user_agent contains \"ProRataInc\") or (http.user_agent contains \"Terracotta\") or (http.user_agent contains \"TikTokSpider\") or (http.user_agent contains \"Timpibot\")))",
        "ref": "[CF AI Audit]"
      }
    ]
  },
